NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

PRINTIFY_API_TOKEN=

# AI presenter/video provider endpoints and optional bearer token.
AVATAR_PROVIDER_URL=
# Use {jobId} where the provider job id belongs, e.g. https://provider.example/jobs/{jobId}
AVATAR_PROVIDER_STATUS_URL=
AVATAR_PROVIDER_TOKEN=

# Shared by server-side TikTok/YouTube/Facebook/Instagram adapters posting normalized events.
LIVE_CONNECTOR_SECRET=

# Shared secret used to sign OAuth state and encrypt provider tokens.
PROVIDER_OAUTH_SECRET=

# YouTube provider connection credentials.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.readonly

# Meta OAuth + webhook verification and x-hub-signature-256 validation.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_metadata
META_WEBHOOK_VERIFY_TOKEN=

# Encrypts stored RTMP destination credentials.
STREAM_CREDENTIAL_SECRET=

# Long-running RTMP execution belongs on a dedicated worker, not the Vercel request process.
BROADCAST_WORKER_URL=
BROADCAST_WORKER_TOKEN=
# Shared only between the worker and FacelessLive callback endpoint.
BROADCAST_CALLBACK_SECRET=

# Post-purchase vacation-planning reward configuration.
VACATION_PLANNING_DISCOUNT_PERCENT=15
VACATION_PLANNING_MINIMUM_PURCHASE=50
VACATION_PLANNING_MAXIMUM_DISCOUNT=75
VACATION_PLANNING_REWARD_VALIDITY_DAYS=30
