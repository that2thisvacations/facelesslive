NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

PRINTIFY_API_TOKEN=

# AI presenter/video provider endpoints and optional bearer token.
AVATAR_PROVIDER_URL=
# Use {jobId} where the provider job id belongs, e.g. https://provider.example/jobs/{jobId}
AVATAR_PROVIDER_STATUS_URL=
AVATAR_PROVIDER_TOKEN=

# Shared by server-side TikTok/YouTube/Facebook/Instagram adapters posting normalized events.
LIVE_CONNECTOR_SECRET=

# Encrypts stored RTMP destination credentials.
STREAM_CREDENTIAL_SECRET=

# Long-running RTMP execution belongs on a dedicated worker, not the Vercel request process.
BROADCAST_WORKER_URL=
BROADCAST_WORKER_TOKEN=
# Shared only between the worker and FacelessLive callback endpoint.
BROADCAST_CALLBACK_SECRET=
